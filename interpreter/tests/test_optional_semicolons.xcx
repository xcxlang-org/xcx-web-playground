--- XCX 4.4: optional semicolons at block boundaries ---

func greet() {
    >! "hello from func";
}

greet();

func add(i: a, i: b -> i) {
    return a + b;
};
>! add(2, 3);

--- if / elseif / else / end without semicolons ---
i: x = 2;
i: y = 5;

if (x < y) then
    >! "X is smaller than y";
elseif (x > y) then
    >! "X is bigger than y";
else
    >! "x is equal y";
end

if (x > y) then;
    >! "wrong branch";
elseif (x < y) then;
    >! "still works with semicolons";
else;
    >! "wrong branch";
end;

--- while without semicolons ---
i: n = 0;
while (n < 3) do
    >! n;
    n = n + 1;
end

--- for without semicolons ---
for i in 1 to 3 do
    >! i * 10;
end

--- array literal without semicolon ---
array:s: fruits {"apple", "banana", "cherry"}
>! fruits[1];

--- table without semicolon ---
table: users {
    columns = [ id :: i, user_name :: s ]
    rows = [ (1, "Alice"), (2, "Bob") ]
}
>! users.count();

--- map without semicolon ---
map: capitals {
    schema = [s <-> s]
    data = ["PL" :: "Warsaw", "DE" :: "Berlin"]
}
>! capitals.get("PL");

--- set without semicolon ---
set:N: numbers {1, 2, 3}
>! numbers.count();

--- end of optional semicolon tests ---
>! "ALL OPTIONAL SEMICOLON TESTS FINISHED";
