--- ============================================================
--- test_while_break_continue.xcx
--- Full test suite: while, break, continue
--- ============================================================


--- ────────────────────────────────────────────────────────────
--- BLOCK W1: Basic while — counting up
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W1: basic while ===";

i: cnt = 1;
while (cnt <= 5) do;
    >! cnt;
    cnt = cnt + 1;
end;

--- expected: 1 2 3 4 5


--- ────────────────────────────────────────────────────────────
--- BLOCK W2: While — false condition immediately (zero iterations)
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W2: while false immediately ===";

i: zero = 10;
while (zero < 0) do;
    >! "SHOULD NOT APPEAR";
end;
>! "no iterations OK";

--- expected: "no iterations OK"


--- ────────────────────────────────────────────────────────────
--- BLOCK W3: While — exactly one iteration
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W3: exactly one iteration ===";

i: raz = 0;
while (raz == 0) do;
    raz = 1;
    >! "once OK";
end;

--- expected: "once OK"


--- ────────────────────────────────────────────────────────────
--- BLOCK W4: While with composite condition
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W4: complex condition ===";

i: wa = 0;
i: wb = 10;
while (wa < 5 AND wb > 7) do;
    wa = wa + 1;
    wb = wb - 1;
    >! wa;
end;

--- expected: 1 2 3  (at wa==3, wb==7 condition fails)


--- ────────────────────────────────────────────────────────────
--- BLOCK W5: While — sum accumulation
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W5: sum 1..10 ===";

i: suma = 0;
i: idx = 1;
while (idx <= 10) do;
    suma = suma + idx;
    idx = idx + 1;
end;
>! suma;

--- expected: 55


--- ────────────────────────────────────────────────────────────
--- BLOCK W6: While with float
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W6: while with float ===";

f: fval = 0.0;
while (fval < 0.9) do;
    fval = fval + 0.3;
end;
>! fval;

--- expected: 1.2 (IEEE 754: 0.3+0.3+0.3+0.3=1.2, exits loop at 0.9)


--- ────────────────────────────────────────────────────────────
--- BLOCK W7: Break — exiting loop early
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W7: basic break ===";

i: br = 0;
while (br < 100) do;
    br = br + 1;
    if (br == 4) then;
        break;
    end;
    >! br;
end;
>! "after break";

--- expected: 1 2 3 "after break"


--- ────────────────────────────────────────────────────────────
--- BLOCK W8: Break — condition never true (break doesn't trigger)
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W8: break doesn't trigger ===";

i: nb = 0;
while (nb < 3) do;
    nb = nb + 1;
    if (nb == 99) then;
        break;
    end;
    >! nb;
end;

--- expected: 1 2 3


--- ────────────────────────────────────────────────────────────
--- BLOCK W9: Continue — skipping even numbers
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W9: continue odd numbers ===";

i: cv = 0;
while (cv < 8) do;
    cv = cv + 1;
    if (cv % 2 == 0) then;
        continue;
    end;
    >! cv;
end;

--- expected: 1 3 5 7


--- ────────────────────────────────────────────────────────────
--- BLOCK W10: Continue — skipping entire body (zero output)
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W10: continue skips everything ===";

i: ca = 0;
while (ca < 3) do;
    ca = ca + 1;
    continue;
    >! "SHOULD NOT APPEAR";
end;
>! "continue OK";

--- expected: "continue OK"


--- ────────────────────────────────────────────────────────────
--- BLOCK W11: Break and continue together
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W11: break and continue together ===";

i: bc = 0;
while (bc < 20) do;
    bc = bc + 1;
    if (bc % 2 == 0) then; continue; end;
    if (bc == 7) then; break; end;
    >! bc;
end;
>! "end W11";

--- expected: 1 3 5 "end W11"


--- ────────────────────────────────────────────────────────────
--- BLOCK W12: Nested while — inner break
--- Inner variable declared before outer loop
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W12: nested while inner break ===";

i: outer = 0;
i: inner = 0;
while (outer < 3) do;
    outer = outer + 1;
    inner = 0;
    while (inner < 5) do;
        inner = inner + 1;
        if (inner == 3) then; break; end;
    end;
    >! outer;
    >! inner;
end;

--- expected: for each outer: inner stops at 3
--- outer=1 inner=3, outer=2 inner=3, outer=3 inner=3


--- ────────────────────────────────────────────────────────────
--- BLOCK W13: Nested while — outer break
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W13: nested while outer break ===";

i: ox = 0;
i: ix = 0;
while (ox < 5) do;
    ox = ox + 1;
    ix = 0;
    while (ix < 3) do;
        ix = ix + 1;
        >! ix;
    end;
    if (ox == 2) then; break; end;
end;
>! ox;

--- expected: ix 1 2 3 (ox=1), ix 1 2 3 (ox=2), ox=2


--- ────────────────────────────────────────────────────────────
--- BLOCK W14: Nested while — inner continue
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W14: nested while inner continue ===";

i: ow = 0;
i: iw = 0;
while (ow < 2) do;
    ow = ow + 1;
    iw = 0;
    while (iw < 4) do;
        iw = iw + 1;
        if (iw == 2) then; continue; end;
        >! iw;
    end;
end;

--- expected: 1 3 4 (for ow=1), 1 3 4 (for ow=2)


--- ────────────────────────────────────────────────────────────
--- BLOCK W15: While with string operations
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W15: while with string ===";

s: napis = "";
i: si = 0;
while (si < 4) do;
    si = si + 1;
    napis = napis + "x";
end;
>! napis;

--- expected: "xxxx"


--- ────────────────────────────────────────────────────────────
--- BLOCK W16: While with bool as flag
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W16: bool as flag ===";

b: running = true;
i: tick = 0;
while (running) do;
    tick = tick + 1;
    if (tick == 5) then;
        running = false;
    end;
end;
>! tick;

--- expected: 5


--- ────────────────────────────────────────────────────────────
--- BLOCK W17: Break on first iteration
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W17: break on first iteration ===";

i: bf = 0;
while (bf < 100) do;
    break;
    >! "SHOULD NOT APPEAR";
end;
>! "break first OK";

--- expected: "break first OK"


--- ────────────────────────────────────────────────────────────
--- BLOCK W18: While — external variable modification
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W18: external variable modification ===";

i: ext = 0;
i: steps = 0;
while (ext < 100) do;
    ext = ext + 13;
    steps = steps + 1;
end;
>! steps;
>! ext;

--- expected: steps=8, ext=104


--- ────────────────────────────────────────────────────────────
--- BLOCK W19: Continue doesn't skip counter update
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W19: continue doesn't stuck loop ===";

i: safe = 0;
i: printed = 0;
while (safe < 10) do;
    safe = safe + 1;
    if (safe % 3 != 0) then; continue; end;
    printed = printed + 1;
    >! safe;
end;
>! printed;

--- expected: 3 6 9, printed=3


--- ────────────────────────────────────────────────────────────
--- BLOCK W20: While inside if
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W20: while inside if ===";

b: go = true;
i: wif = 0;
if (go) then;
    while (wif < 3) do;
        wif = wif + 1;
        >! wif;
    end;
end;

--- expected: 1 2 3


--- ────────────────────────────────────────────────────────────
--- BLOCK W21: If with elseif/else inside while
--- ────────────────────────────────────────────────────────────

>! "=== BLOCK W21: if/elseif/else inside while ===";

i: grade = 0;
while (grade < 5) do;
    grade = grade + 1;
    if (grade == 1) then;
        >! "one";
    elseif (grade == 3) then;
        >! "three";
    else;
        >! "other";
    end;
end;

--- expected: "one" "other" "three" "other" "other"


>! "=== ALL WHILE/BREAK/CONTINUE TESTS FINISHED ===";
